# Large third-party toolchain payloads — never commit.
#
# EACH IS LISTED TWICE, AND THE SLASHLESS FORM IS THE ONE THAT MATTERS HERE.
# A pattern ending in `/` matches only a directory, and in a git WORKTREE these
# are symlinks into the main checkout -- so the slash-terminated form does not
# match them and `git add -A` happily stages nine symlinks pointing at absolute
# paths on one machine.  That is not hypothetical: it happened once, and was
# caught by reading `git status` after the commit rather than by anything
# automatic.  Keep both forms.
toolchain/dist/
toolchain/dist
toolchain/opt/
toolchain/opt
toolchain/spike-src/
toolchain/spike-src
toolchain/spike-build/
toolchain/spike-build
toolchain/kyber/
toolchain/kyber
toolchain/llvm-project/
toolchain/llvm-project
toolchain/riscv-tests/
toolchain/riscv-arch-test/
toolchain/riscv-formal/
toolchain/install/
toolchain/install
toolchain/.uv-cache
.venv/
.venv

# Build / sim artifacts
build/
obj_dir/
sim_build/
*.o
*.d
*.a
*.elf
*.bin
*.hex
*.vcd
*.fst
*.ghw
__pycache__/
*.pyc
.pytest_cache/
results.xml

# Vivado
fpga/build/
*.jou
*.log
.Xil/
vivado*.str
usage_statistics_webtalk.*

# Formal
tb/formal/*/

