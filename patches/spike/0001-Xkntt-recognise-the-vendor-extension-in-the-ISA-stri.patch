From 9fcd21fa7a6ba671d852a82c888797d18eac3684 Mon Sep 17 00:00:00 2001
From: Liam Fucich <liam.fucich@gmail.com>
Date: Thu, 27 Aug 2026 21:23:51 -0500
Subject: [PATCH 1/3] Xkntt: recognise the vendor extension in the ISA-string
 parser

Spike's generic 'x<name>' path assumes the extension is supplied as a dlopen'd
plugin (lib<name>.so, falling back to libcustomext.so).  Taking that path for
xkntt fails with 'Plugin "imsic_mmio" already registered', because loading
libcustomext.so re-runs the static MMIO device registrations.

Xkntt is built in to this fork rather than shipped as a plugin, so recognise it
before the generic branch and record it in the extension table.  Accepts both
the bare name and versioned spellings ("xkntt0p1"), matching the ISA-string
grammar's <major>p<minor> convention; malformed versions are still rejected.

This adds no instruction semantics -- those land once docs/isa-spec.md is frozen
in Phase 1.  It exists so the extended ISA string is usable by the cosimulation
harness now.

    spike --isa=rv32i_zicsr_zicntr_xkntt0p1 prog.elf
---
 disasm/isa_parser.cc | 26 ++++++++++++++++++++++++++
 riscv/isa_parser.h   |  2 ++
 2 files changed, 28 insertions(+)

diff --git a/disasm/isa_parser.cc b/disasm/isa_parser.cc
index ad93576..ec08bc8 100644
--- a/disasm/isa_parser.cc
+++ b/disasm/isa_parser.cc
@@ -307,6 +307,27 @@ void isa_parser_t::apply_zve_properties(const std::string& ext_str, const char*
   vlen = std::max(vlen, new_elen);
 }
 
+// True for "xkntt" and for versioned spellings such as "xkntt0p1".
+// The ISA-string grammar writes versions as <major>p<minor>.
+static bool is_xkntt_string(const std::string& ext_str)
+{
+  const std::string base = "xkntt";
+  if (ext_str.compare(0, base.size(), base) != 0)
+    return false;
+  const std::string ver = ext_str.substr(base.size());
+  if (ver.empty())
+    return true;
+  size_t pos = 0;
+  while (pos < ver.size() && isdigit((unsigned char)ver[pos])) ++pos;
+  if (pos == 0) return false;                 // must start with a major number
+  if (pos == ver.size()) return true;         // "xkntt1"
+  if (ver[pos] != 'p') return false;
+  ++pos;
+  if (pos == ver.size()) return false;        // trailing 'p' with no minor
+  while (pos < ver.size() && isdigit((unsigned char)ver[pos])) ++pos;
+  return pos == ver.size();
+}
+
 void isa_parser_t::add_extension(const std::string& ext_str, const char* str)
 {
   if (const auto* info = find_extension_info(ext_str)) {
@@ -328,6 +349,11 @@ void isa_parser_t::add_extension(const std::string& ext_str, const char* str)
     if ((new_vlen & (new_vlen - 1)) != 0 || new_vlen < 32 || ext_str.back() != 'b')
       bad_isa_string(str, ("Invalid Zvl string: " + ext_str).c_str());
     vlen = std::max(vlen, new_vlen);
+  } else if (is_xkntt_string(ext_str)) {
+    // Xkntt is built in to this fork rather than dlopen'd as a plugin, so
+    // --isa=rv32i_zicsr_zicntr_xkntt0p1 works with no libcustomext.so.
+    extension_table['X'] = true;
+    extension_table[EXT_XKNTT] = true;
   } else if (!ext_str.empty() && ext_str[0] == 'x') {
     extension_table['X'] = true;
     if (ext_str.size() == 1) {
diff --git a/riscv/isa_parser.h b/riscv/isa_parser.h
index 303ca95..54d5d5f 100644
--- a/riscv/isa_parser.h
+++ b/riscv/isa_parser.h
@@ -137,6 +137,8 @@ typedef enum {
   EXT_ZA64RS,
   EXT_ZA128RS,
   EXT_ZILX,
+  // Xkntt: vendor extension for the ML-KEM NTT coprocessor (see docs/isa-spec.md).
+  EXT_XKNTT,
   NUM_ISA_EXTENSIONS
 } isa_extension_t;
 
