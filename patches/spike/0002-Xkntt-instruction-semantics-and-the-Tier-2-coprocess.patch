diff --git a/riscv/insns/kbfct.h b/riscv/insns/kbfct.h
new file mode 100644
index 0000000..5acb9ba
--- /dev/null
+++ b/riscv/insns/kbfct.h
@@ -0,0 +1,5 @@
+require_extension(EXT_XKNTT);
+// Cooley-Tukey butterfly.  Low half of rd is the low-index coefficient.
+int16_t xk_a = xkntt_lo(RS1), xk_b = xkntt_hi(RS1), xk_z = xkntt_lo(RS2);
+int16_t xk_t = xkntt_mont((int32_t)xk_z * xk_b);
+WRITE_RD(sext32(xkntt_pack((int16_t)(xk_a + xk_t), (int16_t)(xk_a - xk_t))));
diff --git a/riscv/insns/kbfgs.h b/riscv/insns/kbfgs.h
new file mode 100644
index 0000000..cd130e1
--- /dev/null
+++ b/riscv/insns/kbfgs.h
@@ -0,0 +1,7 @@
+require_extension(EXT_XKNTT);
+// Gentleman-Sande butterfly.  Note the multiply is by (b - a), matching
+// fqmul(zeta, r[j+len] - r[j]) in the reference; see isa-spec.md Deviation 1.
+int16_t xk_a = xkntt_lo(RS1), xk_b = xkntt_hi(RS1), xk_z = xkntt_lo(RS2);
+int16_t xk_an = xkntt_barrett((int16_t)(xk_a + xk_b));
+int16_t xk_bn = xkntt_mont((int32_t)xk_z * (int16_t)(xk_b - xk_a));
+WRITE_RD(sext32(xkntt_pack(xk_an, xk_bn)));
diff --git a/riscv/insns/kbmul0.h b/riscv/insns/kbmul0.h
new file mode 100644
index 0000000..abd0c85
--- /dev/null
+++ b/riscv/insns/kbmul0.h
@@ -0,0 +1,8 @@
+require_extension(EXT_XKNTT);
+// c0 = fqmul(fqmul(a1, b1), zeta) + fqmul(a0, b0)
+int16_t xk_a0 = xkntt_lo(RS1), xk_a1 = xkntt_hi(RS1);
+int16_t xk_b0 = xkntt_lo(RS2), xk_b1 = xkntt_hi(RS2);
+int16_t xk_z  = xkntt_lo(RS3);
+int16_t xk_t  = xkntt_mont((int32_t)xk_a1 * xk_b1);
+xk_t = xkntt_mont((int32_t)xk_t * xk_z);
+WRITE_RD(sext32((int32_t)(int16_t)(xk_t + xkntt_mont((int32_t)xk_a0 * xk_b0))));
