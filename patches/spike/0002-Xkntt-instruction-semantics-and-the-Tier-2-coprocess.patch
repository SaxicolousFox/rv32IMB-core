diff --git a/riscv/xkntt.cc b/riscv/xkntt.cc
new file mode 100644
index 0000000..4f10c42
--- /dev/null
+++ b/riscv/xkntt.cc
@@ -0,0 +1,206 @@
+// See LICENSE for license details.
+//
+// Xkntt Tier-2 coprocessor model.  See riscv/xkntt.h for the contract.
+
+#include "xkntt.h"
+
+// 7-bit reversal, as in the reference's init_ntt().
+static unsigned br7(unsigned i)
+{
+  unsigned r = 0;
+  for (unsigned b = 0; b < 7; b++)
+    if (i & (1u << b)) r |= 1u << (6 - b);
+  return r;
+}
+
+static int16_t centre(int v)
+{
+  v %= XKNTT_Q;
+  if (v < 0) v += XKNTT_Q;
+  if (v > XKNTT_Q / 2) v -= XKNTT_Q;
+  return (int16_t)v;
+}
+
+kntt_t::kntt_t()
+  : cfg_desc(0), cfg_mode(0), done(false), err(false), cycles(0)
+{
+  memset(data, 0, sizeof(data));
+
+  // Generate the zeta table rather than hard-coding it (plan B0 is explicit:
+  // "do not hand-copy it").  This is the reference's init_ntt() recipe.
+  int16_t tmp[128];
+  tmp[0] = XKNTT_MONT;
+  int16_t step = (int16_t)((XKNTT_MONT * XKNTT_ROOT) % XKNTT_Q);
+  for (unsigned i = 1; i < 128; i++)
+    tmp[i] = xkntt_mont((int32_t)tmp[i - 1] * step);
+  for (unsigned i = 0; i < 128; i++)
+    zeta[i] = centre(tmp[br7(i)]);
+}
+
+// ------------------------------------------------------------------- MMIO ---
+bool kntt_t::load(reg_t addr, size_t len, uint8_t* bytes)
+{
+  if (addr + len > KNTT_SIZE) return false;
+  // isa-spec.md 5.7: an access while BUSY stalls until the operation
+  // completes and must never return stale data.  In a functional model the
+  // operation has already completed at kntt.start, so the stall is a no-op
+  // here; the obligation lands on the RTL (plan I2).
+  memcpy(bytes, data + addr, len);
+  return true;
+}
+
+bool kntt_t::store(reg_t addr, size_t len, const uint8_t* bytes)
+{
+  if (addr + len > KNTT_SIZE) return false;
+  memcpy(data + addr, bytes, len);
+  return true;
+}
+
+int16_t kntt_t::coeff(unsigned buf, unsigned i) const
+{
+  unsigned off = (buf ? KNTT_BUF_B : KNTT_BUF_A) + 2 * i;
+  return (int16_t)((uint16_t)data[off] | ((uint16_t)data[off + 1] << 8));
+}
+
+void kntt_t::set_coeff(unsigned buf, unsigned i, int16_t v)
+{
+  unsigned off = (buf ? KNTT_BUF_B : KNTT_BUF_A) + 2 * i;
+  data[off]     = (uint8_t)((uint16_t)v & 0xFF);
+  data[off + 1] = (uint8_t)((uint16_t)v >> 8);
+}
+
+// -------------------------------------------------------------- transforms --
+// Bit-exact transcriptions of pq-crystals ref/ntt.c.  The lazy int16 wrapping
+// is deliberate; see model/ntt_ref.py, which these must agree with.
+void kntt_t::fwd_ntt(int16_t* r)
+{
+  unsigned k = 1;
+  for (unsigned len = 128; len >= 2; len >>= 1) {
+    for (unsigned start = 0; start < 256; start = start + 2 * len) {
+      int16_t z = zeta[k++];
+      for (unsigned j = start; j < start + len; j++) {
+        int16_t t = xkntt_mont((int32_t)z * r[j + len]);
+        r[j + len] = (int16_t)(r[j] - t);
+        r[j]       = (int16_t)(r[j] + t);
+      }
+    }
+  }
+}
+
+void kntt_t::inv_ntt(int16_t* r)
+{
+  unsigned k = 127;
+  for (unsigned len = 2; len <= 128; len <<= 1) {
+    for (unsigned start = 0; start < 256; start = start + 2 * len) {
+      int16_t z = zeta[k--];
+      for (unsigned j = start; j < start + len; j++) {
+        int16_t t = r[j];
+        r[j]       = xkntt_barrett((int16_t)(t + r[j + len]));
+        r[j + len] = (int16_t)(r[j + len] - t);
+        r[j + len] = xkntt_mont((int32_t)z * r[j + len]);
+      }
+    }
+  }
+  for (unsigned j = 0; j < 256; j++)
+    r[j] = xkntt_mont((int32_t)r[j] * XKNTT_F);
+}
+
+void kntt_t::basemul(const int16_t* a, const int16_t* b, int16_t* r)
+{
+  for (unsigned i = 0; i < XKNTT_N / 4; i++) {
+    for (unsigned h = 0; h < 2; h++) {
+      unsigned o = 4 * i + 2 * h;
+      int16_t z = h ? (int16_t)-zeta[64 + i] : zeta[64 + i];
+      int16_t c0 = xkntt_mont((int32_t)a[o + 1] * b[o + 1]);
+      c0 = xkntt_mont((int32_t)c0 * z);
+      c0 = (int16_t)(c0 + xkntt_mont((int32_t)a[o] * b[o]));
+      int16_t c1 = xkntt_mont((int32_t)a[o] * b[o + 1]);
+      c1 = (int16_t)(c1 + xkntt_mont((int32_t)a[o + 1] * b[o]));
+      r[o]     = c0;
+      r[o + 1] = c1;
+    }
+  }
+}
+
+// ----------------------------------------------------------- control plane --
+void kntt_t::cfg(uint32_t desc, uint32_t mode)
+{
+  // isa-spec.md 5.3: a mode word with reserved bits set raises ERR and is not
+  // latched.  OP == 3 is reserved (5.1).
+  if ((mode & KNTT_MODE_RSVD) || KNTT_MODE_OP(mode) == 3) {
+    err = true;
+    return;
+  }
+  cfg_desc = desc;
+  cfg_mode = mode;
+}
+
+uint32_t kntt_t::start(uint32_t mode)
+{
+  // isa-spec.md 5.4: no trap.  Returns 0 and sets ERR if the mode is invalid;
+  // BUSY is unreachable in a functional model, so the busy path is exercised
+  // in RTL (plan I2) rather than here.
+  if ((mode & KNTT_MODE_RSVD) || KNTT_MODE_OP(mode) == 3) {
+    err = true;
+    done = false;
+    return 0;
+  }
+  done = false;
+  if (!run(mode)) {
+    err = true;
+    return 0;
+  }
+  done = true;
+  return 1;   // software must test for nonzero, not for == 1 (5.4)
+}
+
+uint32_t kntt_t::wait()
+{
+  // Already idle: return immediately with the current status.  Not an error.
+  return stat();
+}
+
+uint32_t kntt_t::stat() const
+{
+  uint32_t s = 0;
+  if (done) s |= KNTT_ST_DONE;
+  if (err)  s |= KNTT_ST_ERR;
+  uint32_t c = cycles > 0xFFFF ? 0xFFFF : cycles;   // saturating (5.2)
+  return s | (c << 16);
+}
+
+bool kntt_t::run(uint32_t mode)
+{
+  unsigned op  = KNTT_MODE_OP(mode);
+  unsigned src = KNTT_MODE_SRC(mode);
+  unsigned dst = KNTT_MODE_DST(mode);
+
+  int16_t a[XKNTT_N], b[XKNTT_N];
+  for (unsigned i = 0; i < XKNTT_N; i++) {
+    a[i] = coeff(src, i);
+    b[i] = coeff(1 - src, i);
+  }
+
+  switch (op) {
+    case KNTT_OP_NTT:
+      fwd_ntt(a);
+      cycles = 7 * (XKNTT_N / 2) / KNTT_LANES + KNTT_FIXED_CYCLES;
+      break;
+    case KNTT_OP_INTT:
+      inv_ntt(a);
+      cycles = (7 * (XKNTT_N / 2) + XKNTT_N) / KNTT_LANES + KNTT_FIXED_CYCLES;
+      break;
+    case KNTT_OP_BASEMUL:
+      // PROVISIONAL (see xkntt.h): operands are both buffers, SRC selects
+      // which is the first.  Track B (B3) fixes the real descriptor.
+      basemul(a, b, a);
+      cycles = (XKNTT_N / 2) / KNTT_LANES + KNTT_FIXED_CYCLES;
+      break;
+    default:
+      return false;
+  }
+
+  for (unsigned i = 0; i < XKNTT_N; i++)
+    set_coeff(dst, i, a[i]);
+  return true;
+}
diff --git a/riscv/xkntt.h b/riscv/xkntt.h
new file mode 100644
index 0000000..6cd6911
--- /dev/null
+++ b/riscv/xkntt.h
@@ -0,0 +1,122 @@
+// See LICENSE for license details.
+//
+// Xkntt -- ML-KEM-768 NTT vendor extension, version 0.1.
+//
+// The normative definition is docs/isa-spec.md in the riscv-ntt project; the
+// executable one is model/isa/xkntt.py.  Everything here is a transcription of
+// those, and tb/cosim/test_spike_xkntt.py checks this file against the Python
+// model instruction by instruction, so the two cannot drift.
+//
+// Tier 1 (custom-0) is ALU-class arithmetic, implemented inline below and used
+// by riscv/insns/k*.h.  Tier 2 (custom-1) is the block coprocessor: kntt_t is
+// both its state machine and the MMIO device holding its polynomial buffers,
+// so ordinary lw/sw move the data and kntt.start/kntt.wait run the operation.
+
+#ifndef _RISCV_XKNTT_H
+#define _RISCV_XKNTT_H
+
+#include "abstract_device.h"
+#include <cstdint>
+#include <cstring>
+
+#define XKNTT_Q       3329
+#define XKNTT_QINV    (-3327)          // q^-1 mod 2^16, as the reference writes it
+#define XKNTT_N       256              // coefficients per polynomial
+#define XKNTT_MONT    2285             // 2^16 mod q
+#define XKNTT_ROOT    17               // zeta
+#define XKNTT_F       1441             // mont^2 / 128, the invntt scale factor
+
+// ---------------------------------------------------------------- Tier 1 ----
+// Reference reduce.c, transcribed with the same lazy (unreduced) output ranges.
+// The truncations are load-bearing: normalising here would break bit-exactness
+// against the C reference, which is the property the whole project rests on.
+
+static inline int16_t xkntt_mont(int32_t a)
+{
+  int16_t t = (int16_t)((int16_t)a * (int16_t)XKNTT_QINV);
+  return (int16_t)((a - (int32_t)t * XKNTT_Q) >> 16);
+}
+
+static inline int16_t xkntt_barrett(int16_t a)
+{
+  const int16_t v = ((1 << 26) + XKNTT_Q / 2) / XKNTT_Q;   // 20159
+  int16_t t = (int16_t)(((int32_t)v * a + (1 << 25)) >> 26);
+  return (int16_t)(a - (int16_t)(t * XKNTT_Q));
+}
+
+// Coefficient pairs share a register, low half first (isa-spec.md section 2.3).
+static inline int16_t xkntt_lo(uint32_t w) { return (int16_t)(uint16_t)(w & 0xFFFFu); }
+static inline int16_t xkntt_hi(uint32_t w) { return (int16_t)(uint16_t)(w >> 16); }
+static inline uint32_t xkntt_pack(int16_t lo, int16_t hi)
+{
+  return ((uint32_t)(uint16_t)hi << 16) | (uint32_t)(uint16_t)lo;
+}
+
+// ---------------------------------------------------------------- Tier 2 ----
+// Aperture layout.  PROVISIONAL: isa-spec.md section 9 defers the register map
+// and the kntt.cfg descriptor to Track B (plan B3/B7).  Only the mode and
+// status word layouts (sections 5.1/5.2) are frozen, and those are honoured
+// exactly.  Anything below that Track B later contradicts must be changed here
+// and in the spec together.
+#define KNTT_BASE       0x50000000     // between EXT_IO_BASE and DRAM_BASE
+#define KNTT_POLY_BYTES (XKNTT_N * 2)  // 512: 256 coefficients, 16 bits each
+#define KNTT_BUF_A      0x000
+#define KNTT_BUF_B      0x200
+#define KNTT_SIZE       0x400          // exactly the two buffers; beyond is unmapped
+
+// Mode word, isa-spec.md section 5.1
+#define KNTT_MODE_OP(m)   ((m) & 0x3u)
+#define KNTT_MODE_SRC(m)  (((m) >> 2) & 0x1u)
+#define KNTT_MODE_DST(m)  (((m) >> 3) & 0x1u)
+#define KNTT_MODE_RSVD    0xFFFFFFF0u
+#define KNTT_OP_NTT       0u
+#define KNTT_OP_INTT      1u
+#define KNTT_OP_BASEMUL   2u
+
+// Status word, isa-spec.md section 5.2
+#define KNTT_ST_BUSY      0x1u
+#define KNTT_ST_DONE      0x2u
+#define KNTT_ST_ERR       0x4u
+
+// Cycle model.  Spike is functional, not cycle-accurate, so these are the
+// plan's expected shape (B6: P butterfly lanes, one butterfly per lane per
+// cycle) rather than a measurement.  The RTL replaces this with real counts.
+#define KNTT_LANES        4            // plan section 6 expects P = 4
+#define KNTT_FIXED_CYCLES 16           // pipeline fill/drain
+
+class kntt_t : public abstract_device_t {
+ public:
+  kntt_t();
+
+  // MMIO: the data plane.  Ordinary lw/sw against the aperture.
+  bool load(reg_t addr, size_t len, uint8_t* bytes) override;
+  bool store(reg_t addr, size_t len, const uint8_t* bytes) override;
+  reg_t size() override { return KNTT_SIZE; }
+
+  // Control plane: the kntt.* instructions.
+  void cfg(uint32_t desc, uint32_t mode);
+  uint32_t start(uint32_t mode);
+  uint32_t wait();
+  uint32_t stat() const;
+
+  const int16_t* zetas() const { return zeta; }
+
+ private:
+  bool run(uint32_t mode);
+  void fwd_ntt(int16_t* r);
+  void inv_ntt(int16_t* r);
+  void basemul(const int16_t* a, const int16_t* b, int16_t* r);
+
+  int16_t coeff(unsigned buf, unsigned i) const;
+  void set_coeff(unsigned buf, unsigned i, int16_t v);
+
+  uint8_t data[KNTT_SIZE];
+  int16_t zeta[128];
+  uint32_t cfg_desc;
+  uint32_t cfg_mode;
+  bool done;
+  bool err;
+  uint32_t cycles;
+};
+
+#endif
diff --git a/riscv/xkntt_encoding.h b/riscv/xkntt_encoding.h
new file mode 100644
index 0000000..40b519a
--- /dev/null
+++ b/riscv/xkntt_encoding.h
@@ -0,0 +1,63 @@
+/* Xkntt vendor extension, version 0.1 -- encodings.
+ *
+ * Kept out of encoding.h because that file is generated upstream from
+ * riscv-opcodes; a separate header keeps the rebase surface to one #include.
+ *
+ * These bit patterns are frozen in docs/isa-spec.md section 8 and are checked
+ * against it, against model/isa/xkntt.py and against GNU as by the riscv-ntt
+ * regression.  Do not edit one without the others.
+ *
+ * Two things the masks encode that a casual reader will miss:
+ *   - Within custom-0, funct3 in {3,4} selects the R4 format, so kbmul0 and
+ *     kmac leave bits 31:27 free (rs3) and constrain only funct2 in 26:25.
+ *   - Reserved register fields are STRICT: kntt.cfg's rd, kntt.start's rs2 and
+ *     kntt.wait/kntt.stat's rs1+rs2 are folded into the mask, so a nonzero
+ *     value is an illegal instruction rather than being ignored.
+ */
+
+/* The MATCH/MASK defines are guarded; the DECLARE_INSN list deliberately is
+ * NOT, because encoding.h is re-included several times with a different
+ * DECLARE_INSN definition each time. */
+#ifndef _RISCV_XKNTT_ENCODING_H
+#define _RISCV_XKNTT_ENCODING_H
+
+/* Tier 1 -- custom-0 (0x0B), R-type: funct7 | rs2 | rs1 | funct3 | rd | op */
+#define MATCH_KMM        0x0000000b
+#define MASK_KMM         0xfe00707f
+#define MATCH_KBFCT      0x0000100b
+#define MASK_KBFCT       0xfe00707f
+#define MATCH_KBFGS      0x0000200b
+#define MASK_KBFGS       0xfe00707f
+#define MATCH_KBMUL1     0x0000500b
+#define MASK_KBMUL1      0xfe00707f
+
+/* Tier 1 -- custom-0, R4-type: rs3 | funct2 | rs2 | rs1 | funct3 | rd | op */
+#define MATCH_KBMUL0     0x0000300b
+#define MASK_KBMUL0      0x0600707f
+#define MATCH_KMAC       0x0000400b
+#define MASK_KMAC        0x0600707f
+
+/* Tier 2 -- custom-1 (0x2B), R-type with strict reserved register fields */
+#define MATCH_KNTT_CFG   0x0000002b
+#define MASK_KNTT_CFG    0xfe007fff   /* rd reserved */
+#define MATCH_KNTT_START 0x0000102b
+#define MASK_KNTT_START  0xfff0707f   /* rs2 reserved */
+#define MATCH_KNTT_WAIT  0x0000202b
+#define MASK_KNTT_WAIT   0xffff707f   /* rs1, rs2 reserved */
+#define MATCH_KNTT_STAT  0x0000302b
+#define MASK_KNTT_STAT   0xffff707f   /* rs1, rs2 reserved */
+
+#endif /* _RISCV_XKNTT_ENCODING_H */
+
+#ifdef DECLARE_INSN
+DECLARE_INSN(kmm, MATCH_KMM, MASK_KMM)
+DECLARE_INSN(kbfct, MATCH_KBFCT, MASK_KBFCT)
+DECLARE_INSN(kbfgs, MATCH_KBFGS, MASK_KBFGS)
+DECLARE_INSN(kbmul0, MATCH_KBMUL0, MASK_KBMUL0)
+DECLARE_INSN(kmac, MATCH_KMAC, MASK_KMAC)
+DECLARE_INSN(kbmul1, MATCH_KBMUL1, MASK_KBMUL1)
+DECLARE_INSN(kntt_cfg, MATCH_KNTT_CFG, MASK_KNTT_CFG)
+DECLARE_INSN(kntt_start, MATCH_KNTT_START, MASK_KNTT_START)
+DECLARE_INSN(kntt_wait, MATCH_KNTT_WAIT, MASK_KNTT_WAIT)
+DECLARE_INSN(kntt_stat, MATCH_KNTT_STAT, MASK_KNTT_STAT)
+#endif /* DECLARE_INSN */
