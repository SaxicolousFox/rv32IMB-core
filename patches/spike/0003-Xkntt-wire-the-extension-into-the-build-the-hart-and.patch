 	$(riscv_insn_ext_i) \
 	$(riscv_insn_ext_c) \
@@ -1853,6 +1874,7 @@ riscv_insn_list = \
 	$(riscv_insn_ext_zcmop) \
 	$(riscv_insn_ext_zicfilp) \
 	$(riscv_insn_ext_zicfiss) \
+	$(riscv_insn_ext_xkntt) \
 
 riscv_gen_srcs = $(addsuffix .cc,$(riscv_insn_list))
 
@@ -1863,7 +1885,7 @@ insn_list.h: $(src_dir)/riscv/riscv.mk.in
 	mv $@.tmp $@
 
 $(riscv_gen_srcs): %.cc: insns/%.h insn_template.cc
-	sed 's/NAME/$(subst .cc,,$@)/' $(src_dir)/riscv/insn_template.cc | sed 's/OPCODE/$(call get_opcode,$(src_dir)/riscv/encoding.h,$(subst .cc,,$@))/' > $@
+	sed 's/NAME/$(subst .cc,,$@)/' $(src_dir)/riscv/insn_template.cc | sed 's/OPCODE/$(call get_opcode,$(encoding_hdrs),$(subst .cc,,$@))/' > $@
 
