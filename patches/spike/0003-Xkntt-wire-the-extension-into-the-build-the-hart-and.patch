diff --git a/riscv/riscv.mk.in b/riscv/riscv.mk.in
index df29533..e7dff1c 100644
--- a/riscv/riscv.mk.in
+++ b/riscv/riscv.mk.in
@@ -1,5 +1,8 @@
 get_insn_list = $(shell grep ^DECLARE_INSN $(1) | sed 's/DECLARE_INSN(\(.*\),.*,.*)/\1/')
-get_opcode = $(shell grep ^DECLARE_INSN.*\\\<$(2)\\\> $(1) | sed 's/DECLARE_INSN(.*,\(.*\),.*)/\1/')
+get_opcode = $(shell grep -h ^DECLARE_INSN.*\\\<$(2)\\\> $(1) | sed 's/DECLARE_INSN(.*,\(.*\),.*)/\1/')
+# Xkntt keeps its DECLARE_INSNs in their own header so encoding.h, which is
+# generated upstream, needs only a one-line change.  get_opcode must see both.
+encoding_hdrs = $(src_dir)/riscv/encoding.h $(src_dir)/riscv/xkntt_encoding.h
 
