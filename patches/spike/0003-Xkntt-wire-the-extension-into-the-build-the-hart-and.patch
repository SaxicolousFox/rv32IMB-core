diff --git a/disasm/disasm.cc b/disasm/disasm.cc
index 3dab773..0d9cc33 100644
--- a/disasm/disasm.cc
+++ b/disasm/disasm.cc
@@ -2230,6 +2230,22 @@ void disassembler_t::add_instructions(const isa_parser_t* isa, bool strict)
     DEFINE_RTYPE(czero_nez);
   }
 
+  // Xkntt -- ML-KEM-768 NTT vendor extension (riscv-ntt project).  Needed so
+  // --log-commits stays readable, and so the A5 cosim differ can name the
+  // instruction that diverged instead of printing a bare word.
+  if (ext_enabled(EXT_XKNTT)) {
+    DEFINE_RTYPE(kmm);
+    DEFINE_RTYPE(kbfct);
+    DEFINE_RTYPE(kbfgs);
+    DEFINE_RTYPE(kbmul1);
+    DISASM_INSN("kbmul0", kbmul0, 0, {&xrd, &xrs1, &xrs2, &xrs3});
+    DISASM_INSN("kmac", kmac, 0, {&xrd, &xrs1, &xrs2, &xrs3});
+    DISASM_INSN("kntt.cfg", kntt_cfg, 0, {&xrs1, &xrs2});
+    DISASM_INSN("kntt.start", kntt_start, 0, {&xrd, &xrs1});
+    DISASM_INSN("kntt.wait", kntt_wait, 0, {&xrd});
+    DISASM_INSN("kntt.stat", kntt_stat, 0, {&xrd});
+  }
+
   if (ext_enabled(EXT_ZIMOP)) {
     #define DISASM_MOP_R(name, rs1, rd) \
       add_insn(new disasm_insn_t(#name, match_##name | (rs1 << 15) | (rd << 7), \
