 }
 
+// The SoC has one Xkntt coprocessor; its polynomial buffers appear at
+// KNTT_BASE so bulk data movement is ordinary lw/sw, while the kntt.*
+// instructions reach the same object directly through the hart.
+void sim_t::attach_kntt()
+{
+  if (!procs.empty() && procs[0]->get_isa().extension_enabled(EXT_XKNTT))
+    bus.add_device(KNTT_BASE, procs[0]->get_kntt());
+}
+
 sim_t::~sim_t()
 {
   for (size_t i = 0; i < procs.size(); i++)
