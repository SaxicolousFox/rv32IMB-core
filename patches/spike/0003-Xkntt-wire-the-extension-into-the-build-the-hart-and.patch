+# require_extension(EXT_XKNTT) in each body does the gating.
+riscv_insn_ext_xkntt = \
+	kmm \
+	kbfct \
+	kbfgs \
+	kbmul0 \
+	kbmul1 \
+	kmac \
+	kntt_cfg \
+	kntt_start \
+	kntt_wait \
